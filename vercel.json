{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "data/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/admin/orders", "destination": "/api/admin?type=orders" },
    { "source": "/api/admin/leads", "destination": "/api/admin?type=leads" },
    { "source": "/api/admin/(.*)", "destination": "/api/admin" },
    { "source": "/api/order", "destination": "/api/order" },
    { "source": "/api/autosave", "destination": "/api/autosave" },
    { "source": "/api/order.php", "destination": "/api/order" },
    { "source": "/api/autosave.php", "destination": "/api/autosave" },
    { "source": "/api/admin.php", "destination": "/api/admin" }
  ]
}
