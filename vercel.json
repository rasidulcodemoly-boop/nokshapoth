{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/admin/orders", "destination": "/api/admin.js" },
    { "source": "/api/admin/leads", "destination": "/api/admin.js" },
    { "source": "/api/admin/(.*)", "destination": "/api/admin.js" },
    { "source": "/api/admin", "destination": "/api/admin.js" },
    { "source": "/api/order", "destination": "/api/order.js" },
    { "source": "/api/autosave", "destination": "/api/autosave.js" },
    { "source": "/api/order.php", "destination": "/api/order.js" },
    { "source": "/api/autosave.php", "destination": "/api/autosave.js" },
    { "source": "/api/admin.php", "destination": "/api/admin.js" }
  ]
}
